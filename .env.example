DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

API_KEYS=dev-tablet-key

# Address printed in the QR stickers (empty: the address used to print them)
LABELS_BASE_URL=

# Where the rental data lives: orm (PostgreSQL) or mongo (MongoDB)
REPOSITORY_BACKEND=orm
MONGO_URL=mongodb://mongo:27017/?directConnection=true
MONGO_DB=ski_rental

# Notifiers: logging, email, or both (logging,email). Emails go to the shop; in development
# Mailpit catches them all: http://localhost:8025
NOTIFIERS=logging
SHOP_EMAIL=shop@example.com
EMAIL_HOST=mailpit
EMAIL_PORT=1025

# The hosted demo uses one URL instead of the POSTGRES_* lines (Neon's connection string):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_DB=ski_rental
POSTGRES_USER=ski_rental
POSTGRES_PASSWORD=ski_rental
POSTGRES_HOST=db
POSTGRES_PORT=5432
